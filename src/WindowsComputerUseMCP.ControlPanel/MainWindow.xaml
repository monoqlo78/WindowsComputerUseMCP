<Window x:Class="WindowsComputerUseMCP.ControlPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WindowsComputerUseMCP.ControlPanel"
        mc:Ignorable="d"
        Title="WindowsComputerUseMCP ControlPanel" Height="560" Width="900"
        MinHeight="400" MinWidth="640">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 状態バナー -->
        <Border Grid.Row="0" x:Name="StatusBanner" Padding="12" CornerRadius="4" Background="#FF9E9E9E">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusText" Text="サーバー未接続" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusDetailText" Text="" FontSize="12" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 操作ボタン -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,12">
            <Button x:Name="EmergencyStopButton" Content="緊急停止" Width="140" Height="36" Background="#FFD32F2F" Foreground="White" FontWeight="Bold" Click="EmergencyStopButton_Click" />
            <Button x:Name="ResumeButton" Content="解除" Width="140" Height="36" Margin="8,0,0,0" Click="ResumeButton_Click" />
            <Button x:Name="RefreshButton" Content="更新" Width="100" Height="36" Margin="24,0,0,0" Click="RefreshButton_Click" />
            <TextBlock Text="ホットキー: Ctrl+Shift+F12 でも緊急停止できます" VerticalAlignment="Center" Margin="24,0,0,0" Foreground="Gray" />
        </StackPanel>

        <!-- 監査ログ一覧 -->
        <GroupBox Grid.Row="2" Header="監査ログ（最新順・入力文字列はマスク済み）">
            <DataGrid x:Name="AuditLogGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="時刻" Binding="{Binding TimestampLocal}" Width="150" />
                    <DataGridTextColumn Header="ツール" Binding="{Binding ToolName}" Width="180" />
                    <DataGridTextColumn Header="対象ウィンドウ" Binding="{Binding TargetWindow}" Width="180" />
                    <DataGridTextColumn Header="プロセス" Binding="{Binding TargetProcess}" Width="120" />
                    <DataGridTextColumn Header="結果" Binding="{Binding Result}" Width="140" />
                    <DataGridTextColumn Header="所要(ms)" Binding="{Binding DurationMs}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <TextBlock Grid.Row="3" x:Name="FooterText" Margin="0,8,0,0" Foreground="Gray" Text="" />
    </Grid>
</Window>
