{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "WindowsComputerUseMcp": {
    "Safety": {
      "AllowedProcesses": [],
      "DeniedProcesses": [],
      "AllowMouseClicks": true,
      "AllowKeyboardInput": true,
      "RequireConfirmationForDangerousActions": true,
      "MaxConsecutiveOperations": 30,
      "RateLimitWindowSeconds": 10,
      "MinOperationIntervalMs": 0,
      "EmergencyStopHotkey": "Ctrl+Shift+F12",
      "AllowPasswordFieldInput": false
    },
    "Logging": {
      "AuditLogEnabled": true,
      "AuditLogRetentionDays": 30,
      "ScreenshotSaveEnabled": true,
      "ScreenshotRetentionDays": 7
    },
    "UiAutomation": {
      "MaxTreeElements": 500,
      "MaxTreeDepth": 10
    }
  }
}
